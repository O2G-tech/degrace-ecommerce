<UserControl x:Class="DeGraceAdmin.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="ATELIER CURATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushGold}" />
                <TextBlock Text="Product Catalogue &amp; Stock" FontSize="24" FontWeight="Bold" FontFamily="Georgia" Foreground="{StaticResource BrushText}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="+ ADD NEW PIECE" Style="{StaticResource GoldButtonStyle}" Command="{Binding OpenAddModalCommand}" Margin="0,0,10,0" />
                <Button Content="REFRESH" Style="{StaticResource OutlineButtonStyle}" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <!-- Search / Filter Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource DarkTextBoxStyle}"
                     Height="38" />

            <TextBlock Grid.Column="0"
                       Text="🔍 Search product name, collection, description..."
                       Foreground="{StaticResource BrushTextMuted}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="14,0,0,0"
                       IsHitTestVisible="False"
                       Visibility="{Binding SearchQuery, Converter={StaticResource EmptyStringToVis}}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="EDIT SELECTED PIECE"
                        Style="{StaticResource OutlineButtonStyle}"
                        Margin="0,0,10,0"
                        Command="{Binding OpenEditModalCommand}" />
                <Button Content="DELETE SELECTED"
                        Style="{StaticResource OutlineButtonStyle}"
                        Foreground="{StaticResource BrushDanger}"
                        BorderBrush="{StaticResource BrushDanger}"
                        Command="{Binding DeleteProductCommand}" />
            </StackPanel>
        </Grid>

        <!-- Products DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedProduct}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                    <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="260" />
                    <DataGridTextColumn Header="Collection / Category" Binding="{Binding CategoryName}" Width="180" />
                    <DataGridTextColumn Header="Price" Binding="{Binding FormattedPrice}" Width="140" />
                    <DataGridTextColumn Header="Stock Available" Binding="{Binding Stock}" Width="130" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                    <DataGridTextColumn Header="Date Added" Binding="{Binding CreatedAt}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Add / Edit Product Modal Overlay -->
        <Grid Grid.RowSpan="3"
              Background="#D00A0A0C"
              Visibility="{Binding IsAddModalOpen, Converter={StaticResource BoolToVis}}"
              Margin="-30">
            <Border Width="500"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource CardBorderStyle}"
                    BorderBrush="{StaticResource BrushBorderGold}"
                    Padding="28">
                <StackPanel>
                    <TextBlock Text="{Binding ModalTitle}"
                               FontSize="14"
                               FontWeight="Bold"
                               FontFamily="Georgia"
                               Foreground="{StaticResource BrushGold}"
                               Margin="0,0,0,18" />

                    <!-- Product Name -->
                    <TextBlock Text="PIECE TITLE / NAME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewProductName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,14" />

                    <!-- Category -->
                    <TextBlock Text="COLLECTION CATEGORY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding AvailableCategories}"
                              SelectedItem="{Binding SelectedNewCategory}"
                              DisplayMemberPath="Name"
                              Height="38"
                              Margin="0,0,0,14" />

                    <!-- Image / Picture URL -->
                    <TextBlock Text="IMAGE / PICTURE URL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewProductImage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,14" />

                    <!-- Price and Stock Row -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="15" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PRICE (₦)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewProductPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="STOCK QUANTITY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewProductStock, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <!-- Description -->
                    <TextBlock Text="DESCRIPTION &amp; DETAILS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewProductDescription, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBoxStyle}"
                             Height="65"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0,0,0,20" />

                    <!-- Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="CANCEL" Style="{StaticResource OutlineButtonStyle}" Command="{Binding CloseAddModalCommand}" />
                        <Button Grid.Column="2" Content="SAVE TO ATELIER" Style="{StaticResource GoldButtonStyle}" Command="{Binding SaveProductCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
