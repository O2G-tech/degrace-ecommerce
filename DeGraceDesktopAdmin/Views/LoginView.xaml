<UserControl x:Class="DeGraceAdmin.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:DeGraceAdmin.ViewModels"
             xmlns:conv="clr-namespace:DeGraceAdmin.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
    </UserControl.Resources>

    <Grid Background="{StaticResource BrushBackground}">
        <Border Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource CardBorderStyle}"
                BorderBrush="{StaticResource BrushBorderGold}"
                Padding="36">
            
            <StackPanel>
                <!-- Brand Emblem Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,28">
                    <TextBlock Text="DE-GRACE"
                               FontSize="22"
                               FontWeight="Bold"
                               FontFamily="Georgia"
                               Foreground="{StaticResource BrushGold}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="CLASSIC BOUTIQUE"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,0" />
                    <TextBlock Text="EXECUTIVE DESKTOP SUITE"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushGoldLight}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                </StackPanel>

                <!-- Status / Error Messages -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource BrushDanger}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource BrushGold}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />

                <!-- Server Endpoint URL -->
                <TextBlock Text="API SERVER ENDPOINT URL"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushGold}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DarkTextBoxStyle}"
                         Margin="0,0,0,16" />

                <!-- Email Input -->
                <TextBlock Text="ADMINISTRATOR EMAIL"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextMuted}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DarkTextBoxStyle}"
                         Margin="0,0,0,18" />

                <!-- Password Input -->
                <TextBlock Text="SECURITY KEY / PASSWORD"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextMuted}"
                           Margin="0,0,0,6" />
                <PasswordBox x:Name="TxtPassword"
                             Style="{StaticResource DarkPasswordBoxStyle}"
                             PasswordChanged="TxtPassword_PasswordChanged"
                             Margin="0,0,0,24" />

                <!-- Login Button -->
                <Button Content="ENTER EXECUTIVE SUITE"
                        Style="{StaticResource GoldButtonStyle}"
                        Command="{Binding LoginCommand}"
                        Height="44" />

                <TextBlock Text="DE-GRACE REST API • PORT 80 • AIRTIGHT ISOLATION"
                           FontSize="9"
                           Foreground="{StaticResource BrushTextSubtle}"
                           HorizontalAlignment="Center"
                           Margin="0,24,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>


