<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme Colors -->
    <Color x:Key="ColorBackground">#0F0F10</Color>
    <Color x:Key="ColorSurface">#171719</Color>
    <Color x:Key="ColorSurfaceAlt">#202024</Color>
    <Color x:Key="ColorCard">#1B1B1E</Color>
    <Color x:Key="ColorBorder">#2E2E35</Color>
    <Color x:Key="ColorBorderGold">#4D3F1E</Color>
    
    <Color x:Key="ColorGold">#D4AF37</Color>
    <Color x:Key="ColorGoldLight">#E8C65A</Color>
    <Color x:Key="ColorGoldDark">#AA8C2C</Color>
    
    <Color x:Key="ColorText">#FFFFFF</Color>
    <Color x:Key="ColorTextMuted">#9E9EA7</Color>
    <Color x:Key="ColorTextSubtle">#6E6E77</Color>

    <Color x:Key="ColorSuccess">#10B981</Color>
    <Color x:Key="ColorDanger">#EF4444</Color>
    <Color x:Key="ColorWarning">#F59E0B</Color>
    <Color x:Key="ColorInfo">#3B82F6</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceAlt" Color="{StaticResource ColorSurfaceAlt}" />
    <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColorCard}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBorderGold" Color="{StaticResource ColorBorderGold}" />

    <SolidColorBrush x:Key="BrushGold" Color="{StaticResource ColorGold}" />
    <SolidColorBrush x:Key="BrushGoldLight" Color="{StaticResource ColorGoldLight}" />
    <SolidColorBrush x:Key="BrushGoldDark" Color="{StaticResource ColorGoldDark}" />

    <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="BrushTextSubtle" Color="{StaticResource ColorTextSubtle}" />

    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource ColorInfo}" />

    <!-- Luxury Gold Gradient -->
    <LinearGradientBrush x:Key="BrushGoldGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E8C65A" Offset="0.0" />
        <GradientStop Color="#D4AF37" Offset="0.5" />
        <GradientStop Color="#AA8C2C" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>


