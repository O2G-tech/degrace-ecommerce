<Application x:Class="DeGraceAdmin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DeGraceAdmin.Converters"
             StartupUri="LoginWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Value Converters -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <conv:StringToVisibilityConverter x:Key="StringToVis" />
            <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVis" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
