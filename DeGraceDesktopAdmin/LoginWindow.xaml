<Window x:Class="DeGraceAdmin.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DeGraceAdmin.Views"
        mc:Ignorable="d"
        Title="DE-GRACE Executive Login" 
        Icon="pack://application:,,,/icon.ico"
        Height="540" Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackground}">

    <views:LoginView x:Name="LoginControl" />
</Window>
